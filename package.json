{
  "name": "bounded-execution-ledger",
  "version": "0.1.0",
  "description": "A fixed-dispatch executor that retains permission decisions, events, outputs, failures, and denials as durable run evidence.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/executor-evidence.mjs && node tests/consumer-api.mjs && node tests/storage-atomicity.mjs",
    "demo": "npm run build && node examples/first-handler.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "examples",
    "LICENSE.md",
    "README.md",
    "SECURITY.md",
    "docs",
    "ORIGIN.md"
  ],
  "license": "MIT"
}
